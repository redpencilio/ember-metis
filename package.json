{
  "name": "ember-metis",
  "version": "0.13.0",
  "description": "Default subject pages for your Linked Data resources.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redpencilio/ember-metis.git"
  },
  "license": "MIT",
  "author": "redpencil.io",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "release": "release-it",
    "start": "ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "overrides": {
    "inputmask": "^5.0.9-beta.45"
  },
  "overridesComments": {
    "inputmask": "5.0.8 is incompatible with FastBoot, remove the override once inputmask ships a new stable version, or when Appuniversum depends on the beta as well: https://github.com/appuniversum/ember-appuniversum/issues/462"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@embroider/macros": "^1.18.2",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "build-url": "^6.0.1",
    "chalk": "^4.1.2",
    "ember-auto-import": "^2.13.1",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-intl": "^7.0.2",
    "ember-template-imports": "^4.4.0",
    "ember-truth-helpers": "^4.0.3",
    "recast": "^0.18.10"
  },
  "dependenciesComments": {
    "chalk": "chalk v5 is an esm-only package which we can't use in our node code since they are cjs modules"
  },
  "peerDependencies": {
    "@appuniversum/ember-appuniversum": "^3.0.0 || ^4.0.0",
    "ember-cli-fastboot": "^4.1.2 || ^5.0.0 || ^6.0.0",
    "ember-source": ">= 4.1.0"
  },
  "peerDependenciesMeta": {
    "ember-cli-fastboot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@appuniversum/ember-appuniversum": "^4.5.1",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@ember/optional-features": "^2.3.0",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/macros": "^1.20.2",
    "@embroider/test-setup": "^4.0.0",
    "@eslint/js": "^9.39.4",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.2.1",
    "ember-cli": "~6.12.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-cli-fastboot": "^4.1.2",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^10.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^6.1.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-warp-drive": "^5.9.1",
    "globals": "^15.15.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.4",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "release-it": "^15.5.0",
    "sass": "^1.21.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "svgxuse": "^1.2.6",
    "webpack": "^5.106.0"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  }
}
